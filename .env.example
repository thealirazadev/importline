# SQLite (default) or a postgresql:// connection string
DATABASE_URL="file:./data/importline.db"

# Directory the server writes uploaded CSV files into
IMPORTLINE_DATA_DIR="./data/uploads"

# Upload size cap in MB; larger uploads are rejected with 413
IMPORT_MAX_FILE_MB="200"

# Rows applied per batch transaction
IMPORT_BATCH_SIZE="1000"

# Attempts per batch before the import pauses
BATCH_MAX_ATTEMPTS="3"
