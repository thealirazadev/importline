{
  "name": "importline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests tests/unit",
    "test:integration": "vitest run --passWithNoTests tests/integration"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.22",
    "papaparse": "5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/node": "24.13.3",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "postcss": "8.5.24",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
